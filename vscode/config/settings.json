{
    "workbench.colorTheme": "Kanagawa",
    "workbench.iconTheme": "symbols",
    "workbench.startupEditor": "none",
    "workbench.activityBar.location": "hidden",
    "workbench.statusBar.visible": true,
    "workbench.breadcrumbs.enabled": false,
    "window.commandCenter": false,
    "window.menuBarVisibility": "classic",
    "workbench.editor.tabSizing": "shrink",
    "explorer.compactFolders": false,
    "editor.minimap.enabled": false,
    "editor.stickyScroll.enabled": false,
    "editor.smoothScrolling": true,
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.hover.delay": 300,
    "editor.scrollbar.verticalScrollbarSize": 8,
    "workbench.list.smoothScrolling": true,
    "terminal.integrated.smoothScrolling": true,
    "editor.fontFamily": "Cascadia Code, Consolas, monospace",
    "editor.fontLigatures": true,
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/.venv": true,
        "**/venv": true
    },
    "search.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/.venv": true,
        "**/venv": true
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/node_modules/**": true,
        "**/__pycache__/**": true,
        "**/*.pyc": true,
        "**/.pytest_cache/**": true,
        "**/.mypy_cache/**": true,
        "**/.venv/**": true,
        "**/venv/**": true
    },
    "liquidGlass.enabled": true,
    "liquidGlass.editorOpacity": 0.45,
    "liquidGlass.sidebarOpacity": 0.84,
    "liquidGlass.quickInputOpacity": 0.88,
    "vscode_custom_css.imports": [],
    "vscode_custom_css.statusbar": false,
    "checksums.autoFix": true,
    "workbench.colorCustomizations": {
        "sideBar.background": "#00000000",
        "sideBarSectionHeader.background": "#00000000",
        "sideBarTitle.background": "#00000000",
        "activityBar.background": "#00000000",
        "titleBar.activeBackground": "#00000000",
        "titleBar.inactiveBackground": "#00000000",
        "editorGroupHeader.tabsBackground": "#00000000",
        "panel.background": "#00000000"
    },
    "python.analysis.typeCheckingMode": "standard",
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 100,
    "python.terminal.useEnvFile": true,
    "chat.mcp.gallery.enabled": true,
    "python.createEnvironment.trigger": "off",
    "git.openRepositoryInParentFolders": "never",
    "chat.titleBar.openInAgentsWindow.enabled": false
}
